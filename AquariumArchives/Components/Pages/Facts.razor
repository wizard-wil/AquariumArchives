@page "/facts"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using AquariumArchives.Models
@using Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage
@inject ProtectedLocalStorage Local
@inject NavigationManager Nav
@inject DatabaseService Db

<PageTitle>Fish facts</PageTitle>

<h1>Fish facts</h1>

<div class="row row-cols-1 row-cols-lg-2 g-3">
    @foreach (var f in allFish)
    {
        <div class="col">
            <div class="card h-100">
                <div class="card-body">
                    <h5 class="card-title">@f.Name</h5>
                    @if (string.IsNullOrWhiteSpace(f.Description))
                    {
                        <p class="card-text text-muted">No facts added yet.</p>
                    }
                    else
                    {
                        <p class="card-text">@f.Description</p>
                    }
                </div>
            </div>
        </div>
    }
</div>

<p class="mt-3">
    <a href="">Today's fish</a> | <a href="collection">My collection</a>
    @if (loggedIn)
    {
        <text> | </text>

        <button class="btn btn-link p-0 align-baseline" @onclick="LogOutAsync">Log out</button>
    }
</p>

@code {
    private List<Fish> allFish = new();

    protected override async Task OnInitializedAsync() =>
        allFish = await Db.GetAllFishAsync();

    private bool loggedIn;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        try
        {
            var session = await Local.GetAsync<string>("session");
            loggedIn = session.Success && session.Value != null;
        }
        catch
        {
            loggedIn = false;
        }

        StateHasChanged();
    }

    private async Task LogOutAsync()
    {
        await Local.DeleteAsync("session");
        Nav.NavigateTo("/");
    }
}

