@page "/wheel"
@rendermode @(new InteractiveServerRenderMode(prerender: false))

@using Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage
@using AquariumArchives.Models

@inject ProtectedLocalStorage Local
@inject DatabaseService Db
@inject NavigationManager Nav

<PageTitle>Fish Wheel - Aquarium Archives</PageTitle>

<div class="wheel-page">

    <h1>Fish Wheel</h1>
    <p class="subtitle">Spin the wheel and discover a new fish!</p>

    @if (!loaded)
    {
        <p>Loading...</p>
    }
    else if (user is null)
    {
        <p>You must be logged in to use the Fish Wheel.</p>
        <a href="login" class="btn btn-primary">Log in</a>
    }
    else
    {
        <div class="wheel-container">

            <div class="pointer">▼</div>

            <div class="wheel" style="@WheelStyle">
                <span>🐠</span>
            </div>

            <button class="btn btn-primary spin-button"
                    @onclick="SpinAsync"
                    disabled="@spinning">

                @(spinning ? "Spinning..." : "SPIN THE WHEEL")
            </button>

            <p class="wheel-note">
                Spin to receive a random fish!
            </p>

        </div>

        @if (!string.IsNullOrEmpty(message))
        {
            <p class="message">@message</p>
        }

        @if (wonFish is not null)
        {
            <div class="fish-result">

                <h2>You won!</h2>

                @if (wonFish.HasImage)
                {
                    <img src="/fish-image/@wonFish.Id"
                         alt="@wonFish.Name" />
                }
                else
                {
                    <div class="fish-placeholder">🐟</div>
                }

                <h3>@wonFish.Name</h3>
                <p>@wonFish.Description</p>

                <p class="success-message">
                    Your fish has been added to your collection!
                </p>

            </div>
        }
    }

</div>

<p class="mt-3">
    <a href="">Today's fish</a> |
    <a href="collection">My collection</a> |
    <a href="facts">Fish facts</a>

    @if (user is not null)
    {
        <text> | </text>
        <button class="btn btn-link p-0 align-baseline"
                @onclick="LogOutAsync">
            Log out
        </button>
    }
</p>

<style>
    .wheel-page {
        text-align: center;
        padding: 30px 15px;
    }

    .subtitle {
        color: #777;
        margin-bottom: 35px;
    }

    .wheel-container {
        display: flex;
        flex-direction: column;
        align-items: center;
        margin: 25px auto;
    }

    .pointer {
        color: #e09b28;
        font-size: 35px;
        line-height: 1;
        margin-bottom: -5px;
        z-index: 1;
    }

    .wheel {
        width: 250px;
        height: 250px;
        border-radius: 50%;
        border: 9px solid #286b91;
        background: conic-gradient( #80d6e8 0deg 45deg, #f5d77a 45deg 90deg, #7bc9a5 90deg 135deg, #80d6e8 135deg 180deg, #f5d77a 180deg 225deg, #7bc9a5 225deg 270deg, #80d6e8 270deg 315deg, #f5d77a 315deg 360deg );
        display: flex;
        justify-content: center;
        align-items: center;
        box-shadow: 0 5px 15px rgba(0,0,0,0.2);
        transition: transform 1.8s cubic-bezier(.15,.7,.15,1);
    }

        .wheel span {
            font-size: 75px;
        }

    .spin-button {
        margin-top: 25px;
        padding: 12px 30px;
        font-weight: bold;
    }

    .wheel-note {
        margin-top: 12px;
        color: #777;
    }

    .message {
        margin-top: 20px;
        font-weight: bold;
    }

    .fish-result {
        max-width: 350px;
        margin: 30px auto;
        padding: 20px;
        border: 1px solid #ddd;
        border-radius: 12px;
        box-shadow: 0 3px 10px rgba(0,0,0,0.08);
    }

        .fish-result img {
            width: 100%;
            max-height: 220px;
            object-fit: contain;
        }

    .fish-placeholder {
        font-size: 80px;
    }

    .success-message {
        color: #23834b;
        font-weight: bold;
    }
</style>

@code {
    private User? user;
    private Fish? wonFish;
    private List<Fish> availableFish = new();

    private bool loaded;
    private bool spinning;
    private string message = "";

    private int wheelRotation;

    private string WheelStyle =>
        $"transform: rotate({wheelRotation}deg);";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        var session = await Local.GetAsync<string>("session");

        if (session.Success && !string.IsNullOrWhiteSpace(session.Value))
        {
            user = await Db.GetUserByUsernameAsync(session.Value);

            if (user is not null)
            {
                var allFish = await Db.GetAllFishAsync();

                availableFish = allFish
                    .Where(f => DatabaseService.IsRandomPoolFish(f.Id))
                    .ToList();
            }
        }

        loaded = true;
        StateHasChanged();
    }

    private async Task SpinAsync()
    {
        if (user is null || spinning)
            return;

        if (availableFish.Count == 0)
        {
            message = "There are no fish available to win right now.";
            return;
        }

        spinning = true;
        wonFish = null;
        message = "";

        //For Furute integration of the coin system, put it here
        //Before spinning, check cost of spin vs coins currently held by the user 
        // if/then statement for rather their is enough money, followed by deduction of coins. Very easy
        //implementation.

        // Rotate the wheel.
        wheelRotation += 1440 + Random.Shared.Next(0, 360);

        await Task.Delay(1900);

        // Random Fish generator
        wonFish = availableFish[
            Random.Shared.Next(availableFish.Count)
        ];

        //Fish added to list
        await Db.AddFishToUserAsync(user.Id, wonFish.Id);

        message = "Congratulations!";

        spinning = false;
    }

    private async Task LogOutAsync()
    {
        await Local.DeleteAsync("session");
        Nav.NavigateTo("/");
    }
}
